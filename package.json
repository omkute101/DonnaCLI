{
  "name": "donna-cli",
  "version": "1.0.0",
  "description": "Donna CLI — A voice-first, agentic developer interface",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "donna": "./bin/donna.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
