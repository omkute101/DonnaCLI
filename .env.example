# Donna CLI — Environment Variables
# Copy this file to .env and fill in your API keys

# OpenAI API Key (required)
OPENAI_API_KEY=sk-...

# ElevenLabs API Key (required for voice features)
ELEVENLABS_API_KEY=...

# ElevenLabs Voice ID (optional — defaults to "Rachel")
# Find voices at: https://elevenlabs.io/voice-library
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# OpenAI Model (optional — defaults to gpt-4o)
OPENAI_MODEL=gpt-4o
