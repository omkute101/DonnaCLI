  "author": "",
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^1.50.1",
    "@google/generative-ai": "^0.24.1",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "conf": "^13.0.1",
    "dotenv": "^16.4.5",
    "eventemitter3": "^5.0.1",
    "ink": "^5.1.0",
    "node-record-lpcm16": "^1.0.1",
    "openai": "^4.73.0",
    "react": "^18.3.1",
    "ws": "^8.18.0",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.23.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
